  <diagram id="hga-deletion" name="Deletion ordering">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="d0"/>
        <mxCell id="d1" parent="d0"/>
        <mxCell id="delete-title" value="Agent deletion is coordinated explicitly — no ownerReferences" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;" vertex="1" parent="d1">
          <mxGeometry x="250" y="30" width="1100" height="45" as="geometry"/>
