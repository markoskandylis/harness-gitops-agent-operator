        <mxCell id="delete-agent" value="1. Agent receives&#xa;deletionTimestamp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="d1">
          <mxGeometry x="55" y="145" width="205" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="fresh-list" value="2. Agent finalizer uses&#xa;fresh APIReader list&#xa;for referencing Mappings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="d1">
          <mxGeometry x="320" y="135" width="235" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="request-delete" value="3. Request deletion of&#xa;every Mapping CR&#xa;Ready=False / WaitingForMappings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="d1">
          <mxGeometry x="615" y="130" width="260" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="mapping-finalizer" value="4. Each Mapping finalizer&#xa;checks stored ownership&#xa;and create state first" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="d1">
          <mxGeometry x="935" y="135" width="245" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="ownership-decision" value="Deletion ownership&#xa;or uncertain create?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="d1">
          <mxGeometry x="1260" y="120" width="230" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="managed-path" value="Managed or Adopted&#xa;fresh claim + Harness List&#xa;exact tuple → delete remote row" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="d1">
          <mxGeometry x="1030" y="365" width="230" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="external-path" value="External or empty&#xa;fast path: no Secret / Harness call&#xa;→ leave remote row intact" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="d1">
          <mxGeometry x="1285" y="365" width="230" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="unknown-path" value="Fresh claim + Harness List&#xa;Pending ID → grace + verify&#xa;OutcomeUnknown → exact adoption" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="d1">
          <mxGeometry x="750" y="365" width="235" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="mapping-gone" value="5. Remove Mapping finalizer&#xa;Mapping CR disappears" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="d1">
          <mxGeometry x="1110" y="565" width="250" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="all-gone" value="6. Fresh list proves all&#xa;referencing Mappings are gone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="d1">
          <mxGeometry x="790" y="565" width="250" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="agent-cleanup" value="7. Agent finalizer&#xa;Managed / verified uncertain → delete&#xa;External → leave intact" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="d1">
          <mxGeometry x="470" y="555" width="260" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="agent-gone" value="8. Remove Agent finalizer&#xa;Agent CR disappears" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="d1">
          <mxGeometry x="170" y="565" width="235" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="delete-credential-note" value="Keep the controller and API-key Secret available until finalization completes.&#xa;Central API-key storage avoids losing cleanup credentials with the runtime namespace." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="d1">
          <mxGeometry x="310" y="770" width="980" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="mismatch-note" value="Safety rule: only the claim winner may delete, and only when the remembered ID still matches the complete stored tuple." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="d1">
          <mxGeometry x="440" y="700" width="720" height="50" as="geometry"/>
